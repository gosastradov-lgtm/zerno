@echo off
chcp 65001 > nul
title Zerno Coffee Server
echo ========================================================
echo    ☕ Запуск веб-платформы кофейни Zerno
echo ========================================================
echo [1/2] Проверка зависимостей Python...
python -m pip install -r requirements.txt --quiet

echo [2/2] Запуск локального сервера...
echo Сайт откроется в браузере по адресу: http://127.0.0.1:8000
echo Чтобы остановить сервер: нажмите Ctrl + C в этом окне
echo ========================================================

start "" http://127.0.0.1:8000
python run.py
pause

